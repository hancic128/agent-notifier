{
  "name": "@hancic-site/agent-notifier",
  "version": "0.0.1",
  "description": "Push notifications for Claude Code, Codex CLI and Kimi Code — Feishu, Lark, Slack, Bark, DingTalk, WeCom, PushDeer and Bluebird.",
  "keywords": [
    "claude-code",
    "codex",
    "kimi-code",
    "ai-agent",
    "notifications",
    "webhook",
    "feishu",
    "lark",
    "slack",
    "bark",
    "dingtalk",
    "wecom",
    "pushdeer",
    "cli"
  ],
  "homepage": "https://github.com/hancic128/agent-notifier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hancic128/agent-notifier.git"
  },
  "bugs": {
    "url": "https://github.com/hancic128/agent-notifier/issues"
  },
  "author": "agent-notifier contributors",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-notifier": "./bin/agent-notifier"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:bun": "bun build --compile --target=bun-darwin-arm64 --outfile=dist/agent-notifier-bun src/cli.ts",
    "dev": "tsc -p tsconfig.build.json && node dist/node/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "commander": "^12.1.0",
    "prompts": "^2.4.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "files": [
    "bin",
    "dist/node",
    "src",
    "docs",
    "install.sh",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "RELEASING.md",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
